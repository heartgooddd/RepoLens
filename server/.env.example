# Template only. Real credentials belong in ignored server/.env.
# The model checker and real task runner read these four model fields.
# Enable the real option via process env REPOLENS_ENABLE_REAL_RUN=1; default is stub.
LLM_PROVIDER=OPENROUTER
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# The client appends /v1/chat/completions; do not put /v1 here.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=

# Optional data directory is read from the server process environment, not this file.
# REPOLENS_DATA_DIR=/absolute/path/to/RepoLens/var

# Optional public-GitHub API token is also read from the server process environment.
# REPOLENS_GITHUB_TOKEN=

# The real-run toggle is read from process env, not from this file.
